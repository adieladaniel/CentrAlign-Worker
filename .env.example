# Copy to .env and fill in GEMINI_API_KEY. Every value below is optional except the key
# (names match worker/config.py; unknown keys in .env are ignored).

# --- LLM provider: gemini | ollama | fake | policy ("fake" is for tests only: it returns nothing useful; "policy" is the
# deterministic stand-in the load test uses, see scripts/loadtest.py and docs/SCALING.md: it drives the real tools for the
# invoice task without any model; POLICY_THINK_MS below is its simulated latency per call) ---
LLM_PROVIDER=gemini
# POLICY_THINK_MS=800

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback chain (comma separated, tried in order). The free tier allows only ~20 requests/day PER MODEL and
# one agent run needs 25-45 calls, so when a model's daily quota is used up the run continues on the next one.
# Models that are unknown (404) or overloaded (503) are skipped too. Put the most reliable models first.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-2.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Optional, backward compatible: a single model that is tried before the chain above.
# GEMINI_MODEL=
# Client-side throttle: minimum seconds between LLM calls (free tier is roughly 10 requests/minute).
# Lower it if your quota allows, raise it if you see 429 errors.
LLM_MIN_INTERVAL_S=4
# Keep retrying for this many seconds when the network is down (DNS / connection errors) before the run stops.
LLM_NETWORK_RETRY_S=300
# Multi-user mode: parallel runs share one token bucket per API key (in PostgreSQL) instead of a per-run throttle.
# Burst size, and calls per second (empty/0 = 1 / LLM_MIN_INTERVAL_S). How often a process re-reads shared model
# health and an org's daily usage (seconds).
# LLM_BUCKET_CAPACITY=2
# LLM_REFILL_PER_S=0
# LLM_HEALTH_CACHE_S=3
# LLM_QUOTA_CACHE_S=5
# Per-org daily budgets (max_tokens_per_day, max_llm_calls_per_day), the model chain and an own Gemini key (vault
# credential "gemini", kind api_key) are set in the Admin page, not here.

# --- Optional local fallback (set LLM_PROVIDER=ollama; needs `ollama serve` and a pulled model) ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# --- Environment the agent works in ---
# Where the simulated company runs. `python run.py` starts it on port 8001, so keep this in sync.
SIM_BASE_URL=http://localhost:8001
# Folder the agent can list/read/write (shared drive with credentials.json).
WORKSPACE_DIR=./workspace
# Run logs, screenshots, downloads, events.jsonl and report.md are written to RUNS_DIR/<run_id>/.
RUNS_DIR=./runs
# true = invisible browser. The dashboard's "Headed browser" switch and the CLI's --headed override this per run.
HEADLESS=true

# --- Agent policy and guards ---
# auto: ask only for irreversible actions | confirm_writes: also ask for writes (default) | confirm_all
APPROVAL_MODE=confirm_writes
# Max real actions (tool calls that touch the outside world; bookkeeping tools do not count).
MAX_STEPS=60
# Consecutive tool failures before the agent is nudged (half this value) and then escalated to the human.
MAX_CONSECUTIVE_FAILURES=4
# Wall-clock limit per run, in seconds.
RUN_TIMEOUT_S=900

# --- PostgreSQL (optional; without it the worker keeps using files under RUNS_DIR and VAULT_DIR) ---
# Create the database, apply migrations and seed the demo orgs/users with: python scripts/bootstrap.py
# Check the connection with: python -m worker.db check     (the password is never printed)
# DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/oneforall
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_S=30
# Also give the demo orgs their own simulated company (needs the simulator running): python scripts/bootstrap.py --provision-sim

# --- Multi-user mode (users, orgs, roles, sessions in PostgreSQL; see README 1.4) ---
# AUTH_MODE decides how people sign in:
#   auto (default)  database mode when DATABASE_URL is set, otherwise the v1 file mode (ACCESS_PASSWORD or no auth)
#   file            ignore DATABASE_URL for sign-in (v1 behaviour)
#   db              always database mode; refuses to start without DATABASE_URL
# In database mode ACCESS_PASSWORD and the global MAX_RUNS_PER_DAY are ignored: users sign in with their own accounts,
# and the run quota, approval mode, MAX_STEPS and RUN_TIMEOUT_S come from each org's settings (Admin page).
# AUTH_MODE=auto
# SESSION_IDLE_TTL_HOURS=12        a session ends after this long without use (the cookie is HttpOnly, SameSite=Lax; Secure when DEPLOY_MODE)
# SESSION_ABSOLUTE_TTL_DAYS=7      ... and at the latest this long after sign-in, however active the user is
# LOGIN_WINDOW_S=900               failed sign-ins are counted per window (fixed buckets)
# LOGIN_MAX_FAILURES_PER_EMAIL=5   then that address is blocked until the window ends (HTTP 429 + Retry-After)
# LOGIN_MAX_FAILURES_PER_IP=20     same per client address (behind a proxy set DEPLOY_MODE so X-Forwarded-For is used)
# LOGIN_BACKOFF_BASE_S=0.5         a failed attempt is answered after base * 2^(failures-1) seconds, at most 8
# VAULT_KEY=                       Fernet key for the credential vault (required with DEPLOY_MODE); python -m worker.vault generate-key

# --- Tools ---
# Hosts the http_request tool may call (comma separated). Everything else is refused.
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Simulated company (set these in your shell, NOT here: company_sim does not read .env) ---
#   SIM_CHAOS=erp_submit_500_once,duplicate_bill   start the sim with chaos flags (see README for the list)
#   SIM_TODAY=2026-10-01                           pin "today" inside the sim (default: the real date)
#   SIM_PORT=8001  SIM_HOST=127.0.0.1  SIM_DATA_DIR=<folder>   (run.py and SIM_BASE_URL assume port 8001)
#   SIM_ADMIN_TOKEN=<secret>                       require this X-Admin-Token on the sim's /admin/* (incl. tenant provisioning)
# Chaos flags are normally toggled from the dashboard or POST /admin/chaos instead.
# SIM_ADMIN_TOKEN=   the worker and the evals send this token to the sim (same value as the sim's); also read from the shell.
# SIM_ENTRY_URL=     set per run by the evals/platform to a tenant's entry link (<sim>/t/<token>/); leave empty otherwise.

# --- Optional: hosting it as a shared, password-protected demo (all off by default; see deploy/start.py + Dockerfile) ---
# ACCESS_PASSWORD=           set -> every page, API call, WebSocket and file needs a login (/login)
# SESSION_SECRET=            signs the login cookie; random per process when empty (logins reset on restart)
# DEPLOY_MODE=1              server mode: always headless, hides the "Headed browser" switch
# PUBLIC_SIM_PROXY=1         serve the simulated company at /company, /mail, /portal, /erp through the worker's port
# MAX_RUNS_PER_DAY=15        runs per UTC day (0 = unlimited); extra runs get HTTP 429
# Container-only (deploy/start.py): PORT (public, default 8080), HOST (default 0.0.0.0), SIM_PORT (internal, default 8001)

# --- Observability (logs, /metrics, health; see docs/ARCHITECTURE.md "Observability") ---
# LOG_LEVEL=INFO
# LOG_FORMAT=            json = one JSON object per line (ts, level, logger, msg, run_id, org_id, user_id, worker_id, request_id);
#                        text = readable lines; empty = json when DEPLOY_MODE is on, text otherwise. Secrets are always masked.
# GET /metrics (Prometheus) is open only in local development (no DEPLOY_MODE, no token, no ACCESS_PASSWORD). Otherwise it
# needs an admin session or this bearer token (Authorization: Bearer <token>) for the scraper:
# METRICS_TOKEN=
# Comma separated e-mails of platform operators: their /api/admin/system shows every org, not only their own.
# PLATFORM_ADMIN_EMAILS=
# QUEUE_SAMPLE_S=15      how often an API process samples the queue-depth gauge from the database
# READINESS_CHECK_SIM=1  /readyz also requires the simulated company (SIM_BASE_URL) to answer; 0 = skip that check
# Workers serve their own metrics on loopback with:  python -m worker.jobs --metrics-port 9101
