# Copy to .env and fill in GEMINI_API_KEY. Every value below is optional except the key
# (names match worker/config.py; unknown keys in .env are ignored).

# --- LLM provider: gemini | ollama | fake ("fake" is for tests only: it returns nothing useful) ---
LLM_PROVIDER=gemini

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback chain (comma separated, tried in order). The free tier allows only ~20 requests/day PER MODEL and
# one agent run needs 25-45 calls, so when a model's daily quota is used up the run continues on the next one.
# Models that are unknown (404) or overloaded (503) are skipped too. Put the most reliable models first.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-2.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Optional, backward compatible: a single model that is tried before the chain above.
# GEMINI_MODEL=
# Client-side throttle: minimum seconds between LLM calls (free tier is roughly 10 requests/minute).
# Lower it if your quota allows, raise it if you see 429 errors.
LLM_MIN_INTERVAL_S=4
# Keep retrying for this many seconds when the network is down (DNS / connection errors) before the run stops.
LLM_NETWORK_RETRY_S=300

# --- Optional local fallback (set LLM_PROVIDER=ollama; needs `ollama serve` and a pulled model) ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# --- Environment the agent works in ---
# Where the simulated company runs. `python run.py` starts it on port 8001, so keep this in sync.
SIM_BASE_URL=http://localhost:8001
# Folder the agent can list/read/write (shared drive with credentials.json).
WORKSPACE_DIR=./workspace
# Run logs, screenshots, downloads, events.jsonl and report.md are written to RUNS_DIR/<run_id>/.
RUNS_DIR=./runs
# true = invisible browser. The dashboard's "Headed browser" switch and the CLI's --headed override this per run.
HEADLESS=true

# --- Agent policy and guards ---
# auto: ask only for irreversible actions | confirm_writes: also ask for writes (default) | confirm_all
APPROVAL_MODE=confirm_writes
# Max real actions (tool calls that touch the outside world; bookkeeping tools do not count).
MAX_STEPS=40
# Consecutive tool failures before the agent is nudged (half this value) and then escalated to the human.
MAX_CONSECUTIVE_FAILURES=4
# Wall-clock limit per run, in seconds.
RUN_TIMEOUT_S=900

# --- Tools ---
# Hosts the http_request tool may call (comma separated). Everything else is refused.
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Simulated company (set these in your shell, NOT here: company_sim does not read .env) ---
#   SIM_CHAOS=erp_submit_500_once,duplicate_bill   start the sim with chaos flags (see README for the list)
#   SIM_TODAY=2026-10-01                           pin "today" inside the sim (default: the real date)
#   SIM_PORT=8001  SIM_HOST=127.0.0.1  SIM_DATA_DIR=<folder>   (run.py and SIM_BASE_URL assume port 8001)
# Chaos flags are normally toggled from the dashboard or POST /admin/chaos instead.

# --- Optional: hosting it as a shared, password-protected demo (all off by default; see deploy/start.py + Dockerfile) ---
# ACCESS_PASSWORD=           set -> every page, API call, WebSocket and file needs a login (/login)
# SESSION_SECRET=            signs the login cookie; random per process when empty (logins reset on restart)
# DEPLOY_MODE=1              server mode: always headless, hides the "Headed browser" switch
# PUBLIC_SIM_PROXY=1         serve the simulated company at /company, /mail, /portal, /erp through the worker's port
# MAX_RUNS_PER_DAY=15        runs per UTC day (0 = unlimited); extra runs get HTTP 429
# Container-only (deploy/start.py): PORT (public, default 8080), HOST (default 0.0.0.0), SIM_PORT (internal, default 8001)
